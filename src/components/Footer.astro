---
---
<!-- Ft1 Mast-headed — wordmark + tagline anchor a single band; compact link row beside; disclosure + copyright below. Knobs: wordmark size=xl, tagline=roman body, links row=inline -->
<footer class="foot-mast">
  <div class="foot-mast__inner">
    <div class="foot-mast__top">
      <div class="foot-mast__brand">
        <span class="foot-mast__mark">CG</span>
        <div>
          <p class="foot-mast__wordmark">Control de Gastos</p>
          <p class="foot-mast__tagline">Directorio independiente de infraestructura de gasto para empresas y agencias.</p>
        </div>
      </div>

      <ul class="foot-mast__links">
        <li><a href="/agencias">Agencias</a></li>
        <li><a href="/legal/privacidad">Privacidad</a></li>
        <li><a href="/legal/cookies">Cookies</a></li>
        <li><a href="/legal/aviso-legal">Aviso legal</a></li>
        <li><a href="/legal/afiliacion">Afiliación</a></li>
      </ul>
    </div>

    <div class="foot-mast__meta">
      <p>&copy; 2026 Control de Gastos. Todos los derechos reservados.</p>
      <p>Algunas soluciones pueden generarnos una comisión, sin coste adicional para ti. <a href="/legal/afiliacion">Más info</a></p>
      <button type="button" id="footer-cookie-prefs" class="foot-mast__cookie-btn">Preferencias de cookies</button>
    </div>
  </div>
</footer>

<style>
  .foot-mast {
    background: var(--color-dark-surface);
    color: var(--color-dark-ink-2);
    padding-block: var(--spacing-2xl) var(--spacing-lg);
  }

  .foot-mast__inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .foot-mast__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-dark-rule);
  }

  .foot-mast__brand {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 26rem;
  }

  .foot-mast__mark {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-chip);
    background: var(--color-dark-ink);
    color: var(--color-dark-surface);
    font-family: var(--font-outlier);
    font-size: 0.6875rem;
    font-weight: 500;
    margin-top: 0.125rem;
  }

  .foot-mast__wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-dark-ink);
    letter-spacing: -0.01em;
    margin: 0 0 0.25rem;
  }

  .foot-mast__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-dark-ink-2);
    margin: 0;
  }

  .foot-mast__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--spacing-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .foot-mast__links a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-dark-ink-2);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  .foot-mast__links a:hover {
    color: var(--color-dark-ink);
  }

  .foot-mast__links a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .foot-mast__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem var(--spacing-lg);
    padding-top: var(--spacing-md);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-dark-ink-2);
  }

  .foot-mast__meta a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .foot-mast__cookie-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-dark-ink-2);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color var(--dur-short) var(--ease-out);
  }

  .foot-mast__cookie-btn:hover {
    color: var(--color-dark-ink);
  }

  .foot-mast__cookie-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (max-width: 40rem) {
    .foot-mast__top {
      flex-direction: column;
    }
  }
</style>

<script>
  document.getElementById('footer-cookie-prefs')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cg:open-cookie-prefs'));
  });
</script>
