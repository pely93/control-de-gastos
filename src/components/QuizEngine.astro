---
---
<div id="quiz-wrapper" class="quiz">
  <div class="quiz__head">
    <span class="quiz__step" id="step-indicator">Pregunta 1 de 7</span>
    <div class="quiz__progress-track">
      <div id="progress-bar" class="quiz__progress-fill" style="width: 14%"></div>
    </div>
  </div>

  <div class="quiz__body">
    <div id="quiz-steps">
      <div class="quiz-step" data-step="1">
        <h3 class="quiz__question">¿Cuál es la naturaleza jurídica o estructura de su actividad?</h3>
        <div class="quiz__options">
          <button type="button" class="quiz-opt" data-key="type" data-value="agencia">Agencia consolidada (gestión de múltiples clientes)</button>
          <button type="button" class="quiz-opt" data-key="type" data-value="freelance">Consultor independiente / profesional autónomo</button>
          <button type="button" class="quiz-opt" data-key="type" data-value="interno">Departamento de marketing interno (in-house)</button>
        </div>
      </div>

      <div class="quiz-step" data-step="2" hidden>
        <h3 class="quiz__question">¿Cuántos profesionales gestionan activamente las campañas de publicidad?</h3>
        <div class="quiz__options">
          <button type="button" class="quiz-opt" data-key="team" data-value="small">Equipo reducido (1–2 personas)</button>
          <button type="button" class="quiz-opt" data-key="team" data-value="medium">Equipo mediano (3–8 personas)</button>
          <button type="button" class="quiz-opt" data-key="team" data-value="large">Estructura corporativa (más de 8 gestores)</button>
        </div>
      </div>

      <div class="quiz-step" data-step="3" hidden>
        <h3 class="quiz__question">¿Qué volumen de cuentas publicitarias administran de forma simultánea?</h3>
        <div class="quiz__options">
          <button type="button" class="quiz-opt" data-key="accounts" data-value="few">Menos de 5 cuentas integradas</button>
          <button type="button" class="quiz-opt" data-key="accounts" data-value="mid">Entre 5 y 20 cuentas operativas</button>
          <button type="button" class="quiz-opt" data-key="accounts" data-value="many">Cartera alta (más de 20 cuentas de anuncios)</button>
        </div>
      </div>

      <div class="quiz-step" data-step="4" hidden>
        <h3 class="quiz__question">¿A cuánto asciende la inversión mensual agregada en plataformas publicitarias?</h3>
        <div class="quiz__options">
          <button type="button" class="quiz-opt" data-key="spend" data-value="low">Inversión inicial (menos de 10.000 € / mes)</button>
          <button type="button" class="quiz-opt" data-key="spend" data-value="mid">Inversión consolidada (10.000 € – 50.000 € / mes)</button>
          <button type="button" class="quiz-opt" data-key="spend" data-value="high">Gran volumen (más de 50.000 € / mes)</button>
        </div>
      </div>

      <div class="quiz-step" data-step="5" hidden>
        <h3 class="quiz__question">¿Se comparten tarjetas bancarias entre diferentes profesionales del equipo?</h3>
        <div class="quiz__options">
          <button type="button" class="quiz-opt" data-key="shared_cards" data-value="yes">Sí, empleamos los mismos métodos de pago para varios flujos o cuentas</button>
          <button type="button" class="quiz-opt" data-key="shared_cards" data-value="no">No, cada cuenta o profesional dispone de un método de pago unívoco</button>
        </div>
      </div>

      <div class="quiz-step" data-step="6" hidden>
        <h3 class="quiz__question">¿Requieren establecer topes o límites de gasto rígidos por cliente o campaña?</h3>
        <div class="quiz__options">
          <button type="button" class="quiz-opt" data-key="limits" data-value="yes">Sí, resulta imprescindible para mitigar desviaciones presupuestarias accidentales</button>
          <button type="button" class="quiz-opt" data-key="limits" data-value="no">No, la monitorización interna de cada plataforma es suficiente</button>
        </div>
      </div>

      <div class="quiz-step" data-step="7" hidden>
        <h3 class="quiz__question">¿Experimentan dificultades recurrentes en la recopilación y conciliación contable de facturas?</h3>
        <div class="quiz__options">
          <button type="button" class="quiz-opt" data-key="reconciliation" data-value="yes">Sí, se dedican excesivas horas administrativas al cierre de mes recopilando justificantes</button>
          <button type="button" class="quiz-opt" data-key="reconciliation" data-value="no">No, el proceso contable se encuentra plenamente optimizado</button>
        </div>
      </div>
    </div>

    <div class="quiz__controls">
      <button type="button" id="prev-btn" class="quiz__prev">&larr; Anterior</button>
      <span class="quiz__privacy">Procesamiento local estrictamente confidencial</span>
    </div>
  </div>

  <div id="result-block" class="quiz-result" hidden>
    <span class="quiz-result__badge">Diagnóstico consultivo ejecutado</span>
    <p class="quiz-result__intro" id="result-intro"></p>

    <div class="quiz-result__section">
      <h4 class="quiz-result__label">Vulnerabilidades operativas identificadas</h4>
      <ul class="quiz-result__list" id="result-painpoints"></ul>
    </div>

    <div class="quiz-result__rec">
      <h4 class="quiz-result__rec-title" id="main-rec-title"></h4>
      <p class="quiz-result__rec-desc" id="main-rec-desc"></p>
    </div>

    <p class="quiz-result__disclosure">
      Transparencia: determinadas sugerencias disponen de acuerdos de afiliación independientes. Esto significa que podemos percibir una compensación económica si decide habilitar una cuenta corporativa, sin repercusión ni coste adicional alguno para su mercantil.
    </p>
    <a href="https://www.qonto.com" target="_blank" rel="noopener noreferrer" class="cta-fill cta-fill--wide">
      Acceder a la plataforma recomendada
    </a>
  </div>
</div>

<style>
  .quiz {
    background: var(--color-paper);
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .quiz__head {
    background: var(--color-paper-3);
    padding: var(--spacing-md) var(--spacing-lg);
    border-bottom: 1px solid var(--color-rule-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .quiz__step {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  .quiz__progress-track {
    width: 8rem;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--color-rule-2);
    overflow: hidden;
    flex-shrink: 0;
  }

  .quiz__progress-fill {
    height: 100%;
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    transition: width var(--dur-med) var(--ease-out);
  }

  .quiz__body {
    padding: var(--spacing-lg);
  }

  .quiz-step[hidden] {
    display: none;
  }

  .quiz__question {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin-bottom: var(--spacing-md);
  }

  .quiz__options {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .quiz-opt {
    text-align: left;
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-input);
    background: var(--color-paper);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    cursor: pointer;
    transition: border-color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }

  .quiz-opt:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .quiz-opt:active {
    transform: translateY(1px);
  }

  .quiz-opt:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .quiz__controls {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-rule-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .quiz__prev {
    background: none;
    border: none;
    padding: 0.5rem 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-3);
    cursor: pointer;
    transition: color var(--dur-short) var(--ease-out);
  }

  .quiz__prev:hover:not(:disabled) {
    color: var(--color-ink);
  }

  .quiz__prev:disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .quiz__prev:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .quiz__privacy {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
  }

  .quiz-result {
    padding: var(--spacing-lg);
    background: var(--color-paper-3);
    border-top: 1px solid var(--color-rule-2);
  }

  .quiz-result[hidden] {
    display: none;
  }

  .quiz-result__badge {
    display: inline-flex;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-chip);
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
  }

  .quiz-result__intro {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-ink);
    margin-bottom: var(--spacing-lg);
    max-width: 42rem;
  }

  .quiz-result__section {
    margin-bottom: var(--spacing-lg);
  }

  .quiz-result__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-2);
    margin-bottom: var(--spacing-sm);
  }

  .quiz-result__list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .quiz-result__list :global(li) {
    display: flex;
    gap: 0.5rem;
  }

  .quiz-result__rec {
    padding: var(--spacing-md);
    background: var(--color-paper);
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-input);
    margin-bottom: var(--spacing-lg);
  }

  .quiz-result__rec-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-ink);
    margin-bottom: 0.375rem;
  }

  .quiz-result__rec-desc {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .quiz-result__disclosure {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-ink-3);
    margin-bottom: var(--spacing-md);
  }

  .cta-fill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out), transform 100ms var(--ease-out);
  }

  .cta-fill--wide {
    width: 100%;
  }

  .cta-fill:hover {
    background: var(--color-accent-strong);
  }

  .cta-fill:active {
    transform: translateY(1px);
  }

  .cta-fill:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>

<script>
  let currentStep = 1;
  const totalSteps = 7;
  const answers: Record<string, string> = {};

  const stepIndicator = document.getElementById('step-indicator');
  const progressBar = document.getElementById('progress-bar');
  const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
  const quizStepsContainer = document.getElementById('quiz-steps');
  const resultBlock = document.getElementById('result-block');

  function updateUI() {
    if(stepIndicator) stepIndicator.textContent = `Pregunta ${currentStep} de ${totalSteps}`;
    if(progressBar) progressBar.style.width = `${(currentStep / totalSteps) * 100}%`;
    if(prevBtn) prevBtn.disabled = currentStep === 1;

    document.querySelectorAll('.quiz-step').forEach(step => {
      const stepNum = parseInt(step.getAttribute('data-step') || '0', 10);
      if(stepNum === currentStep) {
        step.removeAttribute('hidden');
      } else {
        step.setAttribute('hidden', '');
      }
    });
  }

  function handleOptionSelection(key: string, value: string) {
    answers[key] = value;
    if (currentStep < totalSteps) {
      currentStep++;
      updateUI();
    } else {
      renderConsultativeResults();
    }
  }

  function renderConsultativeResults() {
    if(quizStepsContainer) quizStepsContainer.setAttribute('hidden', '');
    if(prevBtn) prevBtn.style.display = 'none';
    if(stepIndicator) stepIndicator.textContent = "Evaluación finalizada";
    if(progressBar) progressBar.style.width = "100%";

    const introEl = document.getElementById('result-intro');
    const painpointsEl = document.getElementById('result-painpoints');
    const recTitleEl = document.getElementById('main-rec-title');
    const recDescEl = document.getElementById('main-rec-desc');

    let introText = "Atendiendo a la arquitectura de su equipo y los flujos de liquidación declarados, se concluye que su prioridad operativa trasciende la mera ejecución del pago de anuncios: requiere salvaguardar la trazabilidad y blindar las cuentas ante incidencias de volumen.";
    let painPointsHTML = "";
    let mainRecTitle = "Infraestructura centralizada mediante tarjetas virtuales corporativas";
    let mainRecDesc = "Es altamente recomendable migrar hacia un ecosistema financiero que permita emitir tarjetas virtuales parametrizables vinculadas de forma unívoca a cada identificador de cliente. Esto anula por completo las suspensiones en cascada dentro de plataformas como Meta Business Manager o Google Ads.";

    if (answers['shared_cards'] === 'yes') {
      painPointsHTML += `<li>&bull; <strong>Riesgo de aislamiento de fondos:</strong> compartir una misma numeración entre cuentas expone la tesorería a bloqueos preventivos globales, paralizando campañas activas sin distinción de cliente.</li>`;
    }
    if (answers['reconciliation'] === 'yes') {
      painPointsHTML += `<li>&bull; <strong>Infección de tiempos administrativos:</strong> la dedicación de recursos cualificados a tareas manuales de extracción y cotejo de justificantes contables merma significativamente el margen neto de sus servicios.</li>`;
      mainRecTitle = "Consolidación financiera con auto-conciliación de justificantes";
      mainRecDesc = "Su organización precisa un software bancario con reglas de bloqueo automático de tarjeta en caso de ausencia de factura adjunta tras 48 horas, forzando la digitalización contable de forma nativa.";
    }
    if (answers['spend'] === 'high' || answers['accounts'] === 'many') {
      painPointsHTML += `<li>&bull; <strong>Vulnerabilidad por escala operativa:</strong> supervisar presupuestos variables en un porfolio amplio eleva exponencialmente la probabilidad de descuadres manuales críticos.</li>`;
    }

    if (!painPointsHTML) {
      painPointsHTML = `<li>&bull; Riesgo latente por ausencia de topes financieros estrictos vinculados dinámicamente a la aprobación presupuestaria del cliente.</li>`;
    }

    if(introEl) introEl.innerHTML = introText;
    if(painpointsEl) painpointsEl.innerHTML = painPointsHTML;
    if(recTitleEl) recTitleEl.textContent = mainRecTitle;
    if(recDescEl) recDescEl.textContent = mainRecDesc;

    if(resultBlock) resultBlock.removeAttribute('hidden');
  }

  document.querySelectorAll('.quiz-opt').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const key = target.getAttribute('data-key') || '';
      const value = target.getAttribute('data-value') || '';
      handleOptionSelection(key, value);
    });
  });

  if(prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        updateUI();
      }
    });
  }
</script>
