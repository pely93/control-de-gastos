---
import Layout from '../layouts/Layout.astro';
import QuizEngine from '../components/QuizEngine.astro';
---

<Layout
  title="Tarjetas virtuales y control de gastos para agencias que compran anuncios"
  description="Separa pagos por cliente de forma segura, limita el gasto publicitario exacto por campaña y reduce la conciliación contable manual a final de mes."
>
  <!-- Workbench: functional label (not a badge pill), split diptych with the live spend-limits panel as product proof, then the quiz as the guided tool. -->
  <section class="workbench-hero">
    <div class="workbench-hero__grid">
      <div class="workbench-hero__copy">
        <p class="workbench-hero__label">Diagnóstico gratuito — 2 minutos</p>

        <h1 class="workbench-hero__title">
          Tarjetas virtuales y control de gastos <span class="workbench-hero__accent">para agencias de ads</span>
        </h1>

        <p class="workbench-hero__lede">
          Descubre cómo mejorar el control de gastos de tu agencia y eliminar el caos de tarjetas compartidas, límites poco claros y conciliación manual.
        </p>

        <a href="#quiz" class="cta-fill">
          Solicitar auditoría gratuita
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <ul class="workbench-hero__trust">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Solo 2 minutos</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Sin compromiso</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Datos protegidos (RGPD)</li>
        </ul>
      </div>

      <figure class="panel">
        <figcaption class="panel__caption">Límites por cliente — vista en vivo</figcaption>
        <div class="panel__rows">
          <div class="panel__row">
            <div class="panel__row-head">
              <span>Cliente A — Meta Ads</span>
              <span class="tabular panel__value">82%</span>
            </div>
            <div class="panel__track"><div class="panel__fill" style="width: 82%"></div></div>
          </div>
          <div class="panel__row">
            <div class="panel__row-head">
              <span>Cliente B — Google Ads</span>
              <span class="tabular panel__value">45%</span>
            </div>
            <div class="panel__track"><div class="panel__fill" style="width: 45%"></div></div>
          </div>
          <div class="panel__row">
            <div class="panel__row-head">
              <span>Cliente C — TikTok Ads</span>
              <span class="tabular panel__value">91%</span>
            </div>
            <div class="panel__track"><div class="panel__fill panel__fill--warn" style="width: 91%"></div></div>
          </div>
        </div>
        <p class="panel__footnote">Trazabilidad operativa total sin tarjetas compartidas</p>
      </figure>
    </div>
  </section>

  <section id="quiz" class="quiz-section">
    <div class="quiz-section__inner">
      <p class="quiz-section__label">Evaluación de medios de pago</p>
      <h2 class="quiz-section__heading">Configura tu estructura y descubre qué integraciones mitigan tus cuellos de botella.</h2>
      <QuizEngine />
    </div>
  </section>
</Layout>

<style>
  .workbench-hero {
    padding-block: var(--spacing-2xl) var(--spacing-xl);
    background: var(--color-paper);
  }

  .workbench-hero__grid {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--spacing-2xl);
    align-items: center;
  }

  .workbench-hero__label {
    font-family: var(--font-outlier);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-accent-strong);
    margin-bottom: var(--spacing-sm);
  }

  .workbench-hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-display-s);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .workbench-hero__accent {
    color: var(--color-accent-strong);
  }

  .workbench-hero__lede {
    margin-top: var(--spacing-md);
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 34rem;
  }

  .cta-fill {
    margin-top: var(--spacing-lg);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-short) var(--ease-out), transform 100ms var(--ease-out);
  }

  .cta-fill:hover {
    background: var(--color-accent-strong);
  }

  .cta-fill:active {
    transform: translateY(1px);
  }

  .cta-fill:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .workbench-hero__trust {
    list-style: none;
    margin: var(--spacing-lg) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-2);
  }

  .workbench-hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .workbench-hero__trust svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .panel {
    background: var(--color-ink);
    border-radius: var(--radius-card);
    padding: var(--spacing-lg);
    min-width: 0;
  }

  .panel__caption {
    font-family: var(--font-outlier);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-dark-ink-2);
    text-transform: uppercase;
    margin-bottom: var(--spacing-md);
  }

  .panel__rows {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .panel__row-head {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-dark-ink-2);
    margin-bottom: 0.375rem;
  }

  .panel__value {
    color: var(--color-dark-ink);
    font-weight: 600;
  }

  .panel__track {
    width: 100%;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-dark-rule);
    overflow: hidden;
  }

  .panel__fill {
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .panel__fill--warn {
    background: var(--color-warn);
  }

  .panel__footnote {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-dark-rule);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-dark-ink-2);
    text-align: center;
  }

  .quiz-section {
    padding-block: var(--spacing-2xl) var(--spacing-3xl);
    background: var(--color-paper-2);
  }

  .quiz-section__inner {
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .quiz-section__label {
    font-family: var(--font-outlier);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-accent-strong);
    text-align: center;
    margin-bottom: var(--spacing-sm);
  }

  .quiz-section__heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-2xl);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-align: center;
    max-width: 34rem;
    margin: 0 auto var(--spacing-xl);
  }

  @media (max-width: 60rem) {
    .workbench-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
