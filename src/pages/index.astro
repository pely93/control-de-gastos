---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Directorios de infraestructura de gasto y afiliación"
  description="Directorios técnicos independientes para encontrar la plataforma de emisión de tarjetas y control de gasto adecuada a tu operación."
>
  <!-- Bento Grid hero: fixed-height, centered display, outlined chip CTA -->
  <section class="hero-fixed">
    <div class="hero-fixed__inner">
      <h1 class="hero-fixed__title">
        El directorio de infraestructura de gasto <span class="hero-fixed__accent">para tu empresa</span>
      </h1>
      <p class="hero-fixed__lede">
        Directorios técnicos y guías independientes para encontrar la plataforma de emisión de tarjetas y control operativo adecuada — sin ruido de marketing.
      </p>
      <a href="#directorios" class="chip-outline">Ver directorios</a>
    </div>
  </section>

  <!-- Body: asymmetric bento — one large available tile, two stacked upcoming tiles. Never 3 equal columns. -->
  <section id="directorios" class="bento-section">
    <div class="bento-section__inner">
      <h2 class="bento-section__heading">Directorios disponibles</h2>

      <div class="bento">
        <article class="bento-cell bento-cell--primary">
          <div>
            <div class="bento-cell__head">
              <span class="bento-cell__icon bento-cell__icon--active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
              </span>
              <span class="status-chip status-chip--active">Disponible ahora</span>
            </div>

            <h3 class="bento-cell__title bento-cell__title--primary">Agencias de paid media</h3>
            <p class="bento-cell__desc">
              Control de gasto publicitario, tarjetas virtuales por cliente y campaña, límites automáticos y conciliación simplificada para agencias y compradores de medios.
            </p>

            <div class="bento-cell__tags">
              <span class="tag">Tarjetas virtuales</span>
              <span class="tag">Límites por campaña</span>
              <span class="tag">Control de gastos</span>
              <span class="tag">Conciliación</span>
            </div>
          </div>

          <a href="/agencias" class="cta-fill cta-fill--wide">
            Ver directorio
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </article>

        <article class="bento-cell bento-cell--secondary">
          <div class="bento-cell__head">
            <span class="bento-cell__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </span>
            <span class="status-chip">Próximamente</span>
          </div>
          <h3 class="bento-cell__title">Control de gasto interno</h3>
          <p class="bento-cell__desc bento-cell__desc--muted">
            Tarjetas corporativas, políticas de gasto y reporting automatizado para equipos internos.
          </p>
        </article>

        <article class="bento-cell bento-cell--secondary">
          <div class="bento-cell__head">
            <span class="bento-cell__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </span>
            <span class="status-chip">Próximamente</span>
          </div>
          <h3 class="bento-cell__title">Financiación empresarial</h3>
          <p class="bento-cell__desc bento-cell__desc--muted">
            Crédito para pymes y autónomos en crecimiento — diagnóstico de necesidades y comparativa de productos.
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-fixed {
    padding-block: var(--spacing-3xl) var(--spacing-2xl);
    background: var(--color-paper);
    text-align: center;
  }

  .hero-fixed__inner {
    max-width: 44rem;
    margin-inline: auto;
    padding-inline: var(--spacing-md);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-fixed__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-display-s);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .hero-fixed__accent {
    color: var(--color-accent-strong);
  }

  .hero-fixed__lede {
    margin-top: var(--spacing-md);
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 38rem;
  }

  .chip-outline {
    margin-top: var(--spacing-lg);
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }

  .chip-outline:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .chip-outline:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .bento-section {
    padding-block: var(--spacing-xl) var(--spacing-3xl);
    background: var(--color-paper-2);
  }

  .bento-section__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .bento-section__heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-2xl);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin-bottom: var(--spacing-lg);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .bento-cell {
    background: var(--color-paper);
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-card);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .bento-cell--primary {
    grid-column: 1 / 8;
    grid-row: 1 / 3;
    gap: var(--spacing-xl);
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .bento-cell--primary:hover {
    border-color: var(--color-accent);
  }

  .bento-cell--secondary {
    grid-column: 8 / 13;
    background: var(--color-paper-3);
  }

  .bento-cell__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
  }

  .bento-cell__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-input);
    background: var(--color-paper-3);
    color: var(--color-ink-3);
  }

  .bento-cell__icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .bento-cell__icon--active {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .status-chip {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-paper-3);
    color: var(--color-ink-3);
  }

  .status-chip--active {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .bento-cell__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .bento-cell__title--primary {
    font-size: var(--text-xl);
    color: var(--color-ink);
  }

  .bento-cell__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .bento-cell__desc--muted {
    color: var(--color-ink-3);
  }

  .bento-cell__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--spacing-md);
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.625rem;
    border-radius: var(--radius-chip);
    background: var(--color-paper-3);
    color: var(--color-ink-2);
    border: 1px solid var(--color-rule-2);
  }

  .cta-fill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-short) var(--ease-out), transform 100ms var(--ease-out);
  }

  .cta-fill--wide {
    width: 100%;
  }

  .cta-fill:hover {
    background: var(--color-accent-strong);
  }

  .cta-fill:active {
    transform: translateY(1px);
  }

  .cta-fill:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (max-width: 60rem) {
    .bento-cell--primary,
    .bento-cell--secondary {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
